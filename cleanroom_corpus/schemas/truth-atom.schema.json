{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cleanroom:schema:truth-atom:v1",
  "title": "Clean-room truth atom",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "truth_atom_id",
    "subject_id",
    "predicate",
    "value",
    "confidence",
    "valid_from",
    "valid_to",
    "classification"
  ],
  "properties": {
    "schema": {"const": "cleanroom.truth-atom/v1"},
    "truth_atom_id": {"type": "string", "format": "uuid"},
    "subject_id": {"type": "string", "format": "uuid"},
    "predicate": {"type": "string", "minLength": 1},
    "value": {},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "valid_from": {"type": ["string", "null"]},
    "valid_to": {"type": ["string", "null"]},
    "classification": {"const": "SYNTHETIC_CLEAN_ROOM"}
  }
}
